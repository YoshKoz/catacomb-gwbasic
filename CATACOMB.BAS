3999 REM ================ DUNGEON GENERATOR ================
4000 FOR Y=0 TO 31:FOR X=0 TO 31:A(X,Y)=1:B(X,Y)=0:NEXT X:NEXT Y
4001 NR=0:FOR N=0 TO 15:MG(N)=0:MW(N)=0:NEXT N
4002 FOR TR=1 TO 90
4003  RW=3+FNR(5):RH=3+FNR(4)
4004  RA(NR)=1+FNR(29-RW):RB(NR)=1+FNR(29-RH)
4005  OK=1
4006  FOR Y=RB(NR)-1 TO RB(NR)+RH:FOR X=RA(NR)-1 TO RA(NR)+RW
4007   IF X>=0 AND X<=31 AND Y>=0 AND Y<=31 THEN IF A(X,Y)=0 THEN OK=0
4008  NEXT X:NEXT Y
4009  IF OK=0 THEN 4020
4010  FOR Y=RB(NR) TO RB(NR)+RH-1:FOR X=RA(NR) TO RA(NR)+RW-1:A(X,Y)=0:NEXT X:NEXT Y
4011  RA(NR)=RA(NR)+RW\2:RB(NR)=RB(NR)+RH\2
4012  IF NR>0 THEN GOSUB 4100
4013  NR=NR+1:IF NR>=9 THEN TR=90
4020 NEXT TR
4021 IF NR<3 THEN 4000
4030 GOTO 4200
4099 REM ---- L-shaped corridor from room NR-1 to room NR ----
4100 X=RA(NR-1):Y=RB(NR-1):EX=RA(NR):EY=RB(NR)
4101 IF RND<.5 THEN 4110
4102 WHILE X<>EX:X=X+SGN(EX-X):A(X,Y)=0:WEND
4103 WHILE Y<>EY:Y=Y+SGN(EY-Y):A(X,Y)=0:WEND
4104 RETURN
4110 WHILE Y<>EY:Y=Y+SGN(EY-Y):A(X,Y)=0:WEND
4111 WHILE X<>EX:X=X+SGN(EX-X):A(X,Y)=0:WEND
4112 RETURN
4199 REM ---- populate the level ----
4200 PX=RA(0):PY=RB(0):PF=1
4201 IF FZ<6 THEN B(RA(NR-1),RB(NR-1))=9
4202 REM scatter doors where a corridor pierces a wall line
4203 FOR I=1 TO 60+FZ*6
4204  X=1+FNR(30):Y=1+FNR(30)
4205  IF A(X,Y)<>0 THEN 4208
4206  IF A(X-1,Y)=1 AND A(X+1,Y)=1 AND A(X,Y-1)=0 AND A(X,Y+1)=0 THEN A(X,Y)=2
4207  IF A(X,Y-1)=1 AND A(X,Y+1)=1 AND A(X-1,Y)=0 AND A(X+1,Y)=0 THEN A(X,Y)=2
4208 NEXT I
4210 REM items
4211 NI=9+FZ*2
4212 FOR I=1 TO NI
4213  N=-1:GOSUB 4300
4214  IF FA=0 THEN 4220
4215  R=FNR(100)
4216  IF R<26 THEN B(X,Y)=1 ELSE IF R<50 THEN B(X,Y)=2 ELSE IF R<60 THEN B(X,Y)=7
4217  IF R>=60 AND R<70 THEN B(X,Y)=5
4218  IF R>=70 AND R<78 THEN B(X,Y)=6
4219  IF R>=78 AND R<86 THEN B(X,Y)=3 ELSE IF R>=86 AND R<94 THEN B(X,Y)=4 ELSE IF R>=94 THEN B(X,Y)=8
4220 NEXT I
4230 REM monsters
4231 NM=4+FZ:IF NM>15 THEN NM=15
4232 FOR N=0 TO NM-1
4233  GOSUB 4300
4234  IF FA=0 THEN MG(N)=0:GOTO 4240
4235  KI=FNR(FZ+1):IF KI>3 THEN KI=3
4236  IF FZ>=4 AND FNR(5)=0 THEN KI=5
4237  MK(N)=KI:MG(N)=KH(KI)+FZ*2:MX(N)=X:MY(N)=Y:MW(N)=0
4240 NEXT N
4241 IF FZ<6 THEN 4250
4242 MK(0)=4:MG(0)=KH(4)+30:MW(0)=1
4243 MX(0)=RA(NR-1):MY(0)=RB(NR-1)
4250 GOSUB 5800
4251 RETURN
4299 REM ---- find a free floor cell far from the player: X,Y / FA ----
4300 FA=0
4301 FOR TR2=1 TO 60
4302  X=1+FNR(30):Y=1+FNR(30)
4303  IF A(X,Y)<>0 THEN 4308
4304  IF B(X,Y)<>0 THEN 4308
4305  IF ABS(X-PX)+ABS(Y-PY)<5 THEN 4308
4306  NX=X:NY=Y:GOSUB 5700
4307  IF OC=0 THEN FA=1:TR2=60
4308 NEXT TR2
4309 RETURN
4999 REM ================ PLAYER MOVEMENT ================
5000 NX=PX+VX(PF):NY=PY+VY(PF):GOSUB 5200:RETURN
5050 NX=PX-VX(PF):NY=PY-VY(PF):GOSUB 5200:RETURN
5100 PF=(PF+3) MOD 4:NX=PX+VX(PF):NY=PY+VY(PF):PF=(PF+1) MOD 4:GOSUB 5200:RETURN
5150 PF=(PF+1) MOD 4:NX=PX+VX(PF):NY=PY+VY(PF):PF=(PF+3) MOD 4:GOSUB 5200:RETURN
5199 REM ---- try to enter NX,NY ----
5200 IF NX<0 OR NX>31 OR NY<0 OR NY>31 THEN MS$="SOLID BEDROCK.":RETURN
5201 IF A(NX,NY)=1 THEN MS$="A WALL BLOCKS YOU.":SOUND 120,.6:RETURN
5202 IF A(NX,NY)=2 THEN 5220
5203 N=-1:GOSUB 5750
5204 IF N>=0 THEN GOSUB 6010:TK=1:RETURN
5205 PX=NX:PY=NY:TK=1
5206 IF B(PX,PY)>0 AND B(PX,PY)<>9 THEN MS$="YOU SEE "+IN$(B(PX,PY))+".":RETURN
5207 IF B(PX,PY)=9 THEN MS$="STAIRS DOWN. PRESS > TO DESCEND." ELSE MS$=""
5208 RETURN
5220 IF PK<=0 THEN MS$="THE DOOR IS LOCKED. FIND A KEY.":SOUND 90,1:RETURN
5221 PK=PK-1:A(NX,NY)=0:MS$="THE SILVER KEY TURNS. DOOR OPEN."
5222 SOUND 400,1:SOUND 600,1:TK=1:RETURN
5499 REM ================ MONSTER TURN ================
5500 FOR N=0 TO NM-1
5501  IF MG(N)<=0 THEN 5560
5502  IF MW(N)=1 THEN 5510
5503  IF ABS(MX(N)-PX)+ABS(MY(N)-PY)>10 THEN 5560
5504  LX=MX(N):LY=MY(N):GOSUB 8000
5505  IF LS=0 THEN 5560
5506  MW(N)=1:SOUND 200+FNR(300),.7
5510  IF ABS(MX(N)-PX)+ABS(MY(N)-PY)=1 THEN GOSUB 6100:GOTO 5560
5511  BD=D(MX(N),MY(N)):IF BD>=99 THEN 5560
5512  GX=-1
5513  FOR K=0 TO 3
5514   NX=MX(N)+VX(K):NY=MY(N)+VY(K)
5515   IF NX<0 OR NX>31 OR NY<0 OR NY>31 THEN 5520
5516   IF A(NX,NY)<>0 THEN 5520
5517   IF NX=PX AND NY=PY THEN 5520
5518   GOSUB 5700:IF OC=1 THEN 5520
5519   IF D(NX,NY)<BD THEN BD=D(NX,NY):GX=NX:GY=NY
5520  NEXT K
5521  IF GX>=0 THEN MX(N)=GX:MY(N)=GY
5560 NEXT N
5561 RETURN
5699 REM ---- is NX,NY occupied by a live monster other than N?  -> OC ----
5700 OC=0
5701 FOR Z=0 TO NM-1
5702  IF Z<>N AND MG(Z)>0 AND MX(Z)=NX AND MY(Z)=NY THEN OC=1
5703 NEXT Z
5704 RETURN
5749 REM ---- which live monster stands on NX,NY?  -> N (-1 if none) ----
5750 N=-1
5751 FOR Z=0 TO NM-1
5752  IF MG(Z)>0 AND MX(Z)=NX AND MY(Z)=NY THEN N=Z
5753 NEXT Z
5754 RETURN
5799 REM ================ DIJKSTRA FLOW FIELD ================
5800 X1=PX-11:IF X1<0 THEN X1=0
5801 X2=PX+11:IF X2>31 THEN X2=31
5802 Y1=PY-11:IF Y1<0 THEN Y1=0
5803 Y2=PY+11:IF Y2>31 THEN Y2=31
5804 FOR Y=Y1 TO Y2:FOR X=X1 TO X2:D(X,Y)=99:NEXT X:NEXT Y
5805 QI=0:QJ=1:QX(0)=PX:QY(0)=PY:D(PX,PY)=0
5806 WHILE QI<QJ
5807  X=QX(QI):Y=QY(QI):QI=QI+1:DD=D(X,Y)
5808  IF DD>=10 THEN 5816
5809  FOR K=0 TO 3
5810   NX=X+VX(K):NY=Y+VY(K)
5811   IF NX<X1 OR NX>X2 OR NY<Y1 OR NY>Y2 THEN 5815
5812   IF A(NX,NY)=1 THEN 5815
5813   IF D(NX,NY)<=DD+1 THEN 5815
5814   D(NX,NY)=DD+1:QX(QJ)=NX:QY(QJ)=NY:QJ=QJ+1
5815  NEXT K
5816 WEND
5817 RETURN
5999 REM ================ COMBAT ================
6000 NX=PX+VX(PF):NY=PY+VY(PF)
6001 IF NX<0 OR NX>31 OR NY<0 OR NY>31 THEN MS$="YOU SWING AT STONE.":TK=1:RETURN
6002 N=-1:GOSUB 5750
6003 IF N<0 THEN MS$="YOU SWING AT EMPTY AIR.":SOUND 150,.5:TK=1:RETURN
6010 REM ---- player strikes monster N ----
6011 DM=2+WP*2+PL+FNR(5)
6012 MG(N)=MG(N)-DM:MW(N)=1
6013 SOUND 900,.4:SOUND 500,.5
6014 IF MG(N)>0 THEN MS$="YOU HIT "+KN$(MK(N))+" FOR"+STR$(DM)+".":TK=1:RETURN
6015 MG(N)=0:MS$=KN$(MK(N))+" IS DESTROYED!"
6016 PE=PE+KE(MK(N))+FZ*3
6017 SOUND 300,1:SOUND 200,1:SOUND 120,2
6018 IF MK(N)=4 THEN 9200
6019 GOSUB 6300
6020 TK=1:RETURN
6099 REM ---- monster N strikes the player ----
6100 DM=KD(MK(N))+FNR(4)+FZ-AR*2
6101 IF DM<1 THEN DM=1
6102 PH=PH-DM
6103 MS$=KN$(MK(N))+" HITS YOU FOR"+STR$(DM)+"."
6104 SOUND 180,1:SOUND 110,1
6105 FOR I=0 TO 1:LINE (0,0)-(319,127),2,B:LINE (0,0)-(319,127),0,B:NEXT I
6106 RETURN
6299 REM ---- experience / level up ----
6300 IF PE<PL*PL*28 THEN RETURN
6301 PL=PL+1:PM=PM+9:PH=PM
6302 MS$="YOU REACH LEVEL"+STR$(PL)+"! VIGOUR RESTORED."
6303 PLAY "MFT160O2L16CEGL8>CL16<GL8>E"
6304 GOTO 6300
6499 REM ---- pick up whatever is underfoot ----
6500 U=B(PX,PY)
6501 IF U=0 THEN MS$="THE FLOOR IS BARE HERE.":RETURN
6502 IF U=9 THEN MS$="STAIRS DOWN. PRESS > TO DESCEND.":RETURN
6503 IF U=6 THEN 6520
6504 IF U=1 THEN PT=PT+1:MS$="YOU POCKET A POTION."
6505 IF U=2 THEN G=8+FNR(20)+FZ*4:PG=PG+G:MS$="YOU GATHER"+STR$(G)+" GOLD."
6506 IF U=3 THEN WP=WP+1:MS$="YOUR BLADE IS KEENER. BLD"+STR$(WP)+"."
6507 IF U=4 THEN AR=AR+1:MS$="YOUR MAIL IS STOUTER. MAIL"+STR$(AR)+"."
6508 IF U=5 THEN PK=PK+1:MS$="A SILVER KEY JOINS YOUR RING."
6509 IF U=7 THEN TQ=TQ+150:MS$="THE TORCH BURNS BRIGHT AGAIN."
6510 IF U=8 THEN PM=PM+5:PH=PH+5:MS$="THE SCROLL BURNS. YOU FEEL MIGHTIER."
6511 B(PX,PY)=0:SOUND 700,.5:SOUND 1000,.5:TK=1:RETURN
6520 IF PK<=0 THEN MS$="THE CHEST IS LOCKED. NO KEY.":SOUND 90,1:RETURN
6521 PK=PK-1:B(PX,PY)=0
6522 G=40+FNR(60)+FZ*10:PG=PG+G:PT=PT+1:TQ=TQ+80
6523 MS$="CHEST OPEN:"+STR$(G)+" GOLD, A POTION, OIL."
6524 PLAY "MFT180O3L16CDEFGAB>C"
6525 TK=1:RETURN
6599 REM ---- quaff ----
6600 IF PT<=0 THEN MS$="NO POTIONS LEFT.":RETURN
6601 PT=PT-1:H=12+FNR(9)+PL
6602 PH=PH+H:IF PH>PM THEN PH=PM
6603 MS$="YOU DRINK. RECOVERED"+STR$(H)+" HP."
6604 SOUND 500,.6:SOUND 800,.6:TK=1:RETURN
6699 REM ---- descend ----
6700 IF B(PX,PY)<>9 THEN MS$="NO STAIRS HERE.":RETURN
6701 FZ=FZ+1
6702 LINE (0,0)-(319,127),0,BF
6703 LOCATE 8,9:PRINT "DESCENDING TO DEPTH";FZ;
6704 PLAY "MFT120O2L8GFEDL2C"
6705 TQ=TQ+60
6706 GOSUB 4000
6707 IF FZ=6 THEN MS$="BONE-DUST AND SILVER. SOMETHING VAST STIRS." ELSE MS$="A NEW DEPTH. THE AIR IS COLDER."
6708 TK=0:RETURN

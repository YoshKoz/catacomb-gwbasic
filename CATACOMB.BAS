1999 REM ================ RAYCAST RENDERER ================
2000 REM each column paints its own ceiling, wall and floor: no clear, no flicker
2003 REM torch fuel sets how far the light reaches
2004 L1!=TQ/60+1.2:IF L1!>4.5 THEN L1!=4.5
2005 L2!=L1!*2.1
2010 PXF!=PX+.5:PYF!=PY+.5
2011 DVX!=VX(PF):DVY!=VY(PF)
2012 PLX!=-DVY!*PN!:PLY!=DVX!*PN!
2020 FOR C=0 TO 39
2021  RX!=DVX!*CT!(C)-DVY!*ST!(C)
2022  RY!=DVX!*ST!(C)+DVY!*CT!(C)
2023  IF ABS(RX!)<1E-04 THEN RX!=1E-04
2024  IF ABS(RY!)<1E-04 THEN RY!=1E-04
2025  CX=PX:CY=PY
2026  DDX!=ABS(1/RX!):DDY!=ABS(1/RY!)
2027  IF RX!<0 THEN JX=-1:SD!=(PXF!-CX)*DDX! ELSE JX=1:SD!=(CX+1-PXF!)*DDX!
2028  IF RY!<0 THEN JY=-1:SE!=(PYF!-CY)*DDY! ELSE JY=1:SE!=(CY+1-PYF!)*DDY!
2029  HT=0:SI=0:SS=0
2030  WHILE HT=0 AND SS<26
2031   IF SD!<SE! THEN SD!=SD!+DDX!:CX=CX+JX:SI=0 ELSE SE!=SE!+DDY!:CY=CY+JY:SI=1
2032   SS=SS+1
2033   IF CX<0 OR CX>31 OR CY<0 OR CY>31 THEN HT=2 ELSE IF A(CX,CY)>0 THEN HT=1
2034  WEND
2035  IF HT<>1 THEN ZB!(C)=99:LH=0:GOTO 2040
2036  IF SI=0 THEN PD!=(CX-PXF!+(1-JX)/2)/RX! ELSE PD!=(CY-PYF!+(1-JY)/2)/RY!
2037  IF PD!<.06 THEN PD!=.06
2038  ZB!(C)=PD!
2039  LH=INT(100/PD!):IF LH>136 THEN LH=136
2040  XA=C*8
2041  Y1=64-LH\2:IF Y1<0 THEN Y1=0
2042  Y2=64+LH\2:IF Y2>127 THEN Y2=127
2043  IF LH=0 THEN Y1=64:Y2=63
2044  IF Y1>0 THEN LINE (XA,0)-(XA+7,Y1-1),0,BF
2045  IF Y2<127 THEN LINE (XA,Y2+1)-(XA+7,127),1,BF
2046  IF LH=0 THEN 2060
2047  SH=0:IF PD!>L1! THEN SH=1
2048  IF PD!>L2! THEN SH=2
2049  IF SI=1 THEN SH=SH+1
2050  IF SH>2 THEN SH=2
2051  IF A(CX,CY)=2 THEN CO=2 ELSE IF SH=0 THEN CO=3 ELSE CO=1
2052  LINE (XA,Y1)-(XA+7,Y2),CO,BF
2053  IF SH=2 THEN LINE (XA+1,Y1)-(XA+1,Y2),0:LINE (XA+5,Y1)-(XA+5,Y2),0
2054  IF Y1>0 THEN LINE (XA,Y1)-(XA+7,Y1),0
2055  IF Y2<127 THEN LINE (XA,Y2)-(XA+7,Y2),0
2060 NEXT C
2061 RETURN
2499 REM ================ MONSTER BILLBOARDS ================
2500 IV!=1/(PLX!*DVY!-DVX!*PLY!)
2501 FOR N=0 TO NM-1
2502  IF MG(N)<=0 OR MW(N)=0 THEN 2560
2503  UX!=MX(N)+.5-PXF!:UY!=MY(N)+.5-PYF!
2504  TX!=IV!*(DVY!*UX!-DVX!*UY!)
2505  TY!=IV!*(PLX!*UY!-PLY!*UX!)
2506  IF TY!<.35 OR TY!>13 THEN 2560
2507  SC=INT(160*(1+TX!/TY!))
2508  SZ=INT(112/TY!):IF SZ<8 THEN SZ=8
2509  IF SZ>168 THEN SZ=168
2510  BW=SZ\8:IF BW<1 THEN BW=1
2511  X0=SC-(BW*8)\2:Y0=64+(SZ\2)-BW*8
2512  KI=MK(N):CC=CL(KI)
2513  FOR R=0 TO 7
2514   BM=SP(KI,R):IF BM=0 THEN 2530
2515   YY=Y0+R*BW:IF YY>127 OR YY+BW-1<0 THEN 2530
2516   IF YY<0 THEN YY=0
2517   YB=Y0+R*BW+BW-1:IF YB>127 THEN YB=127
2518   FOR S=0 TO 7
2519    IF (BM AND BT(S))=0 THEN 2526
2520    XX=X0+S*BW:IF XX>319 OR XX+BW-1<0 THEN 2526
2521    XL=XX:IF XL<0 THEN XL=0
2522    XR=XX+BW-1:IF XR>319 THEN XR=319
2523    IF ZB!(XL\8)<=TY! THEN 2526
2524    LINE (XL,YY)-(XR,YB),CC,BF
2526   NEXT S
2530  NEXT R
2560 NEXT N
2561 RETURN
2699 REM ================ ITEM BILLBOARDS ================
2700 X1=PX-7:IF X1<0 THEN X1=0
2701 X2=PX+7:IF X2>31 THEN X2=31
2702 Y1=PY-7:IF Y1<0 THEN Y1=0
2703 Y2=PY+7:IF Y2>31 THEN Y2=31
2704 FOR Y=Y1 TO Y2:FOR X=X1 TO X2
2705  IF B(X,Y)=0 THEN 2750
2706  UX!=X+.5-PXF!:UY!=Y+.5-PYF!
2707  TX!=IV!*(DVY!*UX!-DVX!*UY!)
2708  TY!=IV!*(PLX!*UY!-PLY!*UX!)
2709  IF TY!<.4 OR TY!>8 THEN 2750
2710  SC=INT(160*(1+TX!/TY!))
2711  SZ=INT(56/TY!):IF SZ<8 THEN SZ=8
2712  BW=SZ\8:IF BW<1 THEN BW=1
2713  X0=SC-(BW*8)\2:Y0=64+INT(56/TY!)-BW*8
2714  IF B(X,Y)=9 THEN CC=2 ELSE CC=3
2715  FOR R=0 TO 7
2716   BM=IS(R):IF BM=0 THEN 2730
2717   YY=Y0+R*BW:IF YY>127 OR YY+BW-1<0 THEN 2730
2718   IF YY<0 THEN YY=0
2719   YB=Y0+R*BW+BW-1:IF YB>127 THEN YB=127
2720   FOR S=0 TO 7
2721    IF (BM AND BT(S))=0 THEN 2727
2722    XX=X0+S*BW:IF XX>319 OR XX+BW-1<0 THEN 2727
2723    XL=XX:IF XL<0 THEN XL=0
2724    XR=XX+BW-1:IF XR>319 THEN XR=319
2725    IF ZB!(XL\8)<=TY! THEN 2727
2726    LINE (XL,YY)-(XR,YB),CC,BF
2727   NEXT S
2730  NEXT R
2750 NEXT X:NEXT Y
2751 RETURN

7699 REM ================ LOAD ================
7700 LF=0:SF$="CATACOMB.SAV"
7701 OPEN "I",#1,SF$
7702 INPUT #1,PX,PY,PF,PH,PM,PL,PE,PG,PK,PT,WP,AR,FZ,TU,TQ,NM,NR
7703 FOR Y=0 TO 31
7704  LINE INPUT #1,R$
7705  FOR X=0 TO 31:A(X,Y)=ASC(MID$(R$,X+1,1))-48:NEXT X
7706 NEXT Y
7707 FOR Y=0 TO 31
7708  LINE INPUT #1,R$
7709  FOR X=0 TO 31:B(X,Y)=ASC(MID$(R$,X+1,1))-48:NEXT X
7710 NEXT Y
7711 FOR N=0 TO NM-1:INPUT #1,MX(N),MY(N),MG(N),MK(N),MW(N):NEXT N
7712 FOR I=0 TO NR-1:INPUT #1,RA(I),RB(I):NEXT I
7713 CLOSE #1
7714 GOSUB 5800
7715 ON KEY(1) GOSUB 7000:KEY(1) ON
7716 MS$="EXPEDITION RESUMED.":LF=1
7717 RETURN
7999 REM ================ LINE OF SIGHT: LX,LY -> PX,PY  => LS ================
8000 LS=1
8001 DX!=PX-LX:DY!=PY-LY
8002 NS=ABS(PX-LX):IF ABS(PY-LY)>NS THEN NS=ABS(PY-LY)
8003 IF NS<2 THEN RETURN
8004 IX!=DX!/NS:IY!=DY!/NS
8005 CX!=LX:CY!=LY
8006 FOR K=1 TO NS-1
8007  CX!=CX!+IX!:CY!=CY!+IY!
8008  IF A(INT(CX!+.5),INT(CY!+.5))=1 THEN LS=0:K=NS
8009 NEXT K
8010 RETURN
